# C — Concrete Python skeleton (drop-in MVP)

Below code is a compact but practical starting point. It’s organized for modular policies, pluggable RAG, easy tests.

```python
# mvp_mdp.py
from typing import List, Dict, Any, Optional
import time
import uuid
from dataclasses import dataclass, field

# ------- Data Schemas -------
@dataclass
class StudentProfile:
    student_id: str
    mastery: float = 0.0
    confidence: float = 0.5
    recent_errors: List[str] = field(default_factory=list)

@dataclass
class PlanStep:
    step_id: int
    concept: str
    pedagogy: str  # 'explain', 'example', 'question', 'hint', 'summary'
    content: Optional[str] = None
    content_ref: Optional[str] = None

@dataclass
class Plan:
    plan_id: str
    steps: List[PlanStep]
    meta: Dict[str, Any] = field(default_factory=dict)

# ------- Interfaces -------
class ConceptPolicy:
    """Abstract interface for concept-level policy"""
    def generate_plan(self, state_c: Dict[str, Any]) -> Plan:
        raise NotImplementedError

class TutorPolicy:
    """Abstract interface for tutor-level policy"""
    def decide(self, state_t: Dict[str, Any], observation: Dict[str, Any]) -> Dict[str, Any]:
        raise NotImplementedError

# ------- Simple Concrete Implementations -------
class LLMConceptPolicy(ConceptPolicy):
    def __init__(self, llm_client, rag_client=None):
        self.llm = llm_client
        self.rag = rag_client

    def generate_plan(self, state_c: Dict[str, Any]) -> Plan:
        # Example: call RAG to fetch examples/explanations; prompt LLM to produce plan
        concept = state_c["concept_id"]
        max_steps = state_c.get("constraints", {}).get("max_steps", 4)
        # PSEUDOCODE: rag_result = self.rag.search(concept)
        # Construct prompt using student summary & rag_result, ask LLM for steps
        # For MVP, return a simple templated plan:
        steps = []
        steps.append(PlanStep(1, concept, "explain", content=f"Short explanation of {concept}"))
        steps.append(PlanStep(2, concept, "example", content=f"Worked example for {concept}"))
        steps.append(PlanStep(3, concept, "question", content=f"Question: solve X for {concept}"))
        return Plan(plan_id=str(uuid.uuid4()), steps=steps, meta={"created_at": time.time()})

class SimpleTutorPolicy(TutorPolicy):
    def decide(self, state_t: Dict[str, Any], observation: Dict[str, Any]) -> Dict[str, Any]:
        # observation: {'button': 'continue'|'replan'}
        btn = observation.get("button")
        if btn == "replan":
            return {"action":"replan", "reason":"student_requested"}
        else:
            # continue default
            if state_t["current_step_index"]+1 >= len(state_t["plan"].steps):
                return {"action":"finish"}
            return {"action":"continue"}

# ------- Orchestrator -------
class Orchestrator:
    def __init__(self, concept_policy: ConceptPolicy, tutor_policy: TutorPolicy):
        self.concept_policy = concept_policy
        self.tutor_policy = tutor_policy
        self.tutor_state = {}
    
    def start_session(self, student_profile: StudentProfile, initial_concept: str):
        state_c = {"concept_id": initial_concept, "student_profile": student_profile.__dict__, "constraints": {"max_steps":4}}
        plan = self.concept_policy.generate_plan(state_c)
        self.tutor_state = {
            "plan": plan,
            "current_step_index": 0,
            "student_response_history": [],
            "awaiting_student_input": True
        }
        return self.render_current_step()

    def render_current_step(self):
        step = self.tutor_state["plan"].steps[self.tutor_state["current_step_index"]]
        # Here you would render using your UI/LLM to produce final content
        return {"step": step, "status":"rendered"}

    def handle_button(self, button: str, student_profile: StudentProfile):
        obs = {"button": button}
        decision = self.tutor_policy.decide(self.tutor_state, obs)
        if decision["action"] == "replan":
            # call concept policy with updated profile
            state_c = {"concept_id": self.tutor_state["plan"].steps[self.tutor_state["current_step_index"]].concept,
                       "student_profile": student_profile.__dict__}
            new_plan = self.concept_policy.generate_plan(state_c)
            self.tutor_state["plan"] = new_plan
            self.tutor_state["current_step_index"] = 0
            return self.render_current_step()
        elif decision["action"] == "continue":
            # log and advance
            self.tutor_state["student_response_history"].append({
                "step_id": self.tutor_state["plan"].steps[self.tutor_state["current_step_index"]].step_id,
                "button": "continue", "ts": time.time()
            })
            self.tutor_state["current_step_index"] += 1
            if self.tutor_state["current_step_index"] >= len(self.tutor_state["plan"].steps):
                return {"status":"done"}
            return self.render_current_step()
        elif decision["action"] == "finish":
            return {"status":"done"}
```

